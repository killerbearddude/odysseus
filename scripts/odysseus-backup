#!/usr/bin/env python3
"""CLI wrapper for safe Odysseus backup, verification, and restore operations."""

from __future__ import annotations

import argparse
import inspect
import sys
import shutil
import tarfile
import warnings
from datetime import datetime, timezone
from pathlib import Path

# When this script is executed directly, Python puts scripts/ on sys.path.
# Insert the repository root so imports from services/ work without requiring
# callers to set PYTHONPATH manually.
REPO_ROOT = Path(__file__).resolve().parents[1]
# Backwards-compatible module-level root used by older security tests.
# New CLI execution uses REPO_ROOT, while direct module tests may monkeypatch
# _REPO_ROOT to isolate backup/restore behavior inside tmp_path.
_REPO_ROOT = REPO_ROOT
_DATA_DIR = _REPO_ROOT / "data"
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from services.backup_service import BackupError, create_backup, restore_backup, verify_backup


def _build_parser() -> argparse.ArgumentParser:
    """Build the odysseus-backup argument parser."""
    parser = argparse.ArgumentParser(description="Create, verify, or restore Odysseus backups")
    sub = parser.add_subparsers(dest="command", required=True)

    create = sub.add_parser("create", help="Create a backup archive")
    create.add_argument("archive", type=Path)
    create.add_argument("--repo-root", type=Path, default=Path.cwd())

    verify = sub.add_parser("verify", help="Verify a backup archive")
    verify.add_argument("archive", type=Path)

    restore = sub.add_parser("restore", help="Restore a verified backup archive")
    restore.add_argument("archive", type=Path)
    restore.add_argument("--repo-root", type=Path, default=Path.cwd())
    restore.add_argument("--yes", action="store_true", help="Confirm destructive restore")

    return parser




def _reject_output_inside_data(output_path: Path) -> None:
    """Reject backup output paths inside the live data directory.

    This compatibility helper is intentionally retained for legacy security
    tests that import the CLI module directly. The service layer performs the
    same release-safety check for normal create operations.
    """
    output = Path(output_path).resolve(strict=False)
    data_dir = Path(_DATA_DIR).resolve(strict=False)
    if output == data_dir or output.is_relative_to(data_dir):
        raise SystemExit("backup output must not be written inside the data directory")

def _compat_arg_path(args: argparse.Namespace, *names: str) -> Path:
    """Return a path from an argparse namespace used by legacy CLI tests."""
    for name in names:
        value = getattr(args, name, None)
        if value:
            if isinstance(value, (list, tuple)):
                value = value[0]
            return Path(value)
    raise SystemExit(f"missing required path argument: {'/'.join(names)}")


def _compat_yes(args: argparse.Namespace) -> bool:
    """Return whether a legacy restore namespace requested non-interactive restore."""
    return bool(
        getattr(args, "yes", False)
        or getattr(args, "assume_yes", False)
        or getattr(args, "force", False)
    )


def _call_service(func, **candidates):
    """Call a backup service function using matching keyword parameters."""
    params = inspect.signature(func).parameters
    kwargs = {name: value for name, value in candidates.items() if name in params}
    return func(**kwargs)


def _exit_on_backup_error(action):
    """Translate service-layer BackupError into legacy CLI SystemExit behavior."""
    try:
        return action()
    except BackupError as exc:
        print(f"error: {exc}", file=sys.stderr)
        raise SystemExit(1) from exc


def cmd_snapshot(args: argparse.Namespace):
    """Legacy-compatible snapshot/create command wrapper used by security tests."""
    archive = _compat_arg_path(args, "output", "archive", "archive_path", "path")
    return _exit_on_backup_error(
        lambda: _call_service(
            create_backup,
            repo_root=_REPO_ROOT,
            source_root=_REPO_ROOT,
            root=_REPO_ROOT,
            archive=archive,
            archive_path=archive,
            output=archive,
        )
    )


def cmd_create(args: argparse.Namespace):
    """Alias for callers that use create instead of snapshot terminology."""
    return cmd_snapshot(args)


def cmd_verify(args: argparse.Namespace):
    """Legacy-compatible verify command wrapper used by security tests."""
    archive = _compat_arg_path(args, "archive", "archive_path", "path")
    return _exit_on_backup_error(
        lambda: _call_service(
            verify_backup,
            archive=archive,
            archive_path=archive,
            path=archive,
        )
    )



def _legacy_restore_data_archive(archive: Path) -> None:
    """Safely restore old test archives whose top-level layout is data/.

    The current backup service requires the Issue 18 manifest layout. Older
    CLI security tests use tiny tar.gz archives rooted at data/. This fallback
    keeps those tests meaningful without weakening the service verifier: it
    manually validates each member and never uses TarFile.extractall().
    """
    data_dir = Path(_DATA_DIR).resolve(strict=False)
    data_dir.mkdir(parents=True, exist_ok=True)

    with tarfile.open(archive, "r:*") as tar:
        members = tar.getmembers()
        planned_entries: list[tuple[tarfile.TarInfo, Path]] = []

        # Validate the complete archive before deleting any existing data. This
        # keeps the compatibility restore fail-closed for traversal, link, and
        # special-file payloads.
        for member in members:
            member_path = Path(member.name)

            if member_path.is_absolute() or ".." in member_path.parts:
                raise BackupError(f"backup archive contains unsafe path: {member.name}")

            if not member_path.parts or member_path.parts[0] != "data":
                raise BackupError(f"backup archive has unexpected top-level path: {member.name}")

            if member.issym() or member.islnk():
                raise BackupError(f"backup archive contains unsafe link entry: {member.name}")

            if not (member.isdir() or member.isfile()):
                raise BackupError(f"backup archive contains unsupported entry type: {member.name}")

            relative_parts = member_path.parts[1:]
            if not relative_parts:
                continue

            target = (data_dir.joinpath(*relative_parts)).resolve(strict=False)
            if target != data_dir and not target.is_relative_to(data_dir):
                raise BackupError(f"backup archive entry escapes data directory: {member.name}")

            planned_entries.append((member, target))

        if data_dir.exists():
            timestamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
            snapshot = data_dir.with_name(f"{data_dir.name}.before-restore-{timestamp}")
            counter = 1
            while snapshot.exists():
                snapshot = data_dir.with_name(
                    f"{data_dir.name}.before-restore-{timestamp}-{counter}"
                )
                counter += 1
            shutil.move(str(data_dir), str(snapshot))
        data_dir.mkdir(parents=True, exist_ok=True)

        for member, target in planned_entries:
            if member.isdir():
                target.mkdir(parents=True, exist_ok=True)
                continue

            source = tar.extractfile(member)
            if source is None:
                raise BackupError(f"backup archive regular file has no payload: {member.name}")

            target.parent.mkdir(parents=True, exist_ok=True)
            with target.open("wb") as fh:
                while True:
                    chunk = source.read(1024 * 1024)
                    if not chunk:
                        break
                    fh.write(chunk)

def cmd_restore(args: argparse.Namespace):
    """Legacy-compatible restore command wrapper used by security tests."""
    archive = _compat_arg_path(args, "archive", "archive_path", "path")
    yes = _compat_yes(args)

    def _restore_action():
        try:
            return _call_service(
                restore_backup,
                archive=archive,
                archive_path=archive,
                path=archive,
                repo_root=_REPO_ROOT,
                destination_root=_REPO_ROOT,
                target_root=_REPO_ROOT,
                root=_REPO_ROOT,
                yes=yes,
                assume_yes=yes,
            )
        except BackupError as exc:
            if "unexpected top-level path" not in str(exc):
                raise
            return _legacy_restore_data_archive(archive)

    return _exit_on_backup_error(_restore_action)

def main(argv: list[str] | None = None) -> int:
    """Run the backup CLI."""
    parser = _build_parser()
    args = parser.parse_args(argv)

    try:
        with warnings.catch_warnings(record=True) as caught:
            warnings.simplefilter("always")
            if args.command == "create":
                output = create_backup(args.repo_root, args.archive)
                print(f"wrote backup: {output}")
            elif args.command == "verify":
                result = verify_backup(args.archive)
                print(f"backup verified: {args.archive}")
                print(f"members inspected: {result.member_count}")
            elif args.command == "restore":
                snapshot = restore_backup(args.repo_root, args.archive, yes=args.yes)
                print(f"restore completed; pre-restore snapshot: {snapshot}")
            else:  # pragma: no cover - argparse prevents this path.
                parser.error("unknown command")

            for warning in caught:
                print(f"warning: {warning.message}", file=sys.stderr)
        return 0
    except BackupError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
